--  Crate de ejemplos ejecutables.
with "adalytical.gpr";

project Adalytical_Examples is

   for Source_Dirs use ("examples/**");
   for Object_Dir use "obj/examples";
   for Exec_Dir use "bin";
   for Main use
     ("analisis_basico.adb", "modelo_produccion.adb", "tipo_propio.adb");

   package Compiler renames Adalytical.Compiler;

   package Builder is
      for Switches ("Ada") use ("-j0");
   end Builder;

end Adalytical_Examples;
