root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Ada / GNAT house style: 3-space indentation.
[*.{ads,adb,gpr}]
indent_style = space
indent_size = 3

[*.{sh,toml,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
